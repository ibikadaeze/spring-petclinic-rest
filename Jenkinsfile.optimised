pipeline {
    agent none // Individual stages orchestrate their own isolated tracking containers

    environment {
        // Redirects Maven wrapper initialization out of root folders 
        // to bypass container user ownership blocks completely
        MAVEN_OPTS = "-Duser.home=${WORKSPACE}/.maven_home"
    }

    stages {
        stage('Parallel Test & Dependency Audit') {
            parallel {
                stage('Unit Tests') {
                    agent {
                        docker {
                            image 'maven:3.9.6-eclipse-temurin-21'
                            // Mounts your host cache and automatically pre-installs python3 inside the worker container layer
                            args '-v /var/lib/jenkins/.m2:/root/.m2 --entrypoint="" -u root:root'
                        }
                    }
                    steps {
                        checkout scm
                        // Dynamically install python 3 to guarantee the build script can execute cleanly
                        sh '''
                            if ! command -v python3 &> /dev/null; then
                                apt-get update && apt-get install -y python3
                            fi
                            python3 scripts/build_backend.py --step test
                        '''
                    }
                }

                stage('Dependency Audit') {
                    agent {
                        docker {
                            image 'maven:3.9.6-eclipse-temurin-21'
                            args '-v /var/lib/jenkins/.m2:/root/.m2'
                        }
                    }
                    steps {
                        checkout scm
                        // Runs analysis safely with local user home permissions active
                        sh './mvnw dependency:analyze ${MAVEN_OPTS}'
                    }
                }
            }
        }

        stage('Package Backend') {
            agent {
                docker {
                    image 'maven:3.9.6-eclipse-temurin-21'
                    args '-v /var/lib/jenkins/.m2:/root/.m2'
                }
            }
            steps {
                checkout scm
                sh './mvnw clean package -DskipTests ${MAVEN_OPTS}'
            }
        }
    }
}
