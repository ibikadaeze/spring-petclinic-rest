pipeline {
    agent any // Drop agent none to stop Jenkins from auto-calculating docker wrappers

    stages {
        stage('Parallel Test & Dependency Audit') {
            parallel {
                stage('Unit Tests') {
                    steps {
                        // Manual docker container instantiation to guarantee 0% variable pollution
                        sh '''
                            docker run --rm \
                              -v /var/lib/jenkins/.m2:/root/.m2 \
                              -v "${WORKSPACE}":"${WORKSPACE}" \
                              -w "${WORKSPACE}" \
                              maven:3.9.6-eclipse-temurin-21 \
                              ./mvnw test
                        '''
                    }
                }

                stage('Dependency Audit') {
                    steps {
                        sh '''
                            docker run --rm \
                              -v /var/lib/jenkins/.m2:/root/.m2 \
                              -v "${WORKSPACE}":"${WORKSPACE}" \
                              -w "${WORKSPACE}" \
                              maven:3.9.6-eclipse-temurin-21 \
                              ./mvnw dependency:analyze
                        '''
                    }
                }
            }
        }

        stage('Package Backend') {
            steps {
                sh '''
                    docker run --rm \
                      -v /var/lib/jenkins/.m2:/root/.m2 \
                      -v "${WORKSPACE}":"${WORKSPACE}" \
                      -w "${WORKSPACE}" \
                      maven:3.9.6-eclipse-temurin-21 \
                      ./mvnw clean package -DskipTests
                '''
            }
        }
    }
}
