pipeline {
    agent none // Multi-container agent framework configuration

    environment {
        // OVERRIDE THE CONTAINER HOME DIRECTORY:
        // Forces Maven wrapper scripts out of root system paths and straight into the writable workspace sandbox
        HOME = "${WORKSPACE}"
    }

    stages {
        stage('Parallel Test & Dependency Audit') {
            parallel {
                stage('Unit Tests') {
                    agent {
                        docker {
                            image 'maven:3.9.6-eclipse-temurin-21'
                            // Mount the permanent cache directory on the host to maximize speed
                            args '-v /var/lib/jenkins/.m2:/var/lib/jenkins/.m2'
                        }
                    }
                    steps {
                        checkout scm
                        sh './mvnw test -Dmaven.repo.local=/var/lib/jenkins/.m2/repository'
                    }
                }

                stage('Dependency Audit') {
                    agent {
                        docker {
                            image 'maven:3.9.6-eclipse-temurin-21'
                            args '-v /var/lib/jenkins/.m2:/var/lib/jenkins/.m2'
                        }
                    }
                    steps {
                        checkout scm
                        sh './mvnw dependency:analyze -Dmaven.repo.local=/var/lib/jenkins/.m2/repository'
                    }
                }
            }
        }

        stage('Package Backend') {
            agent {
                docker {
                    image 'maven:3.9.6-eclipse-temurin-21'
                    args '-v /var/lib/jenkins/.m2:/var/lib/jenkins/.m2'
                }
            }
            steps {
                checkout scm
                sh './mvnw clean package -DskipTests -Dmaven.repo.local=/var/lib/jenkins/.m2/repository'
            }
        }
    }
}
