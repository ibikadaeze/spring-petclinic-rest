pipeline {
    agent none // Individual stages orchestrate their own isolated tracking containers

    stages {
        stage('Parallel Test & Dependency Audit') {
            parallel {
                stage('Unit Tests') {
                    agent {
                        docker {
                            image 'maven:3.9.6-eclipse-temurin-21'
                            args '-v /var/lib/jenkins/.m2:/root/.m2'
                        }
                    }
                    steps {
                        checkout scm
                        // Run native maven test execution safely connected to your host cache
                        sh './mvnw test -Dmaven.repo.local=/var/lib/jenkins/.m2/repository'
                    }
                }

                stage('Dependency Audit') {
                    agent {
                        docker {
                            image 'maven:3.9.6-eclipse-temurin-21'
                            args '-v /var/lib/jenkins/.m2:/root/.m2'
                        }
                    }
                    steps {
                        checkout scm
                        sh './mvnw dependency:analyze -Dmaven.repo.local=/var/lib/jenkins/.m2/repository'
                    }
                }
            }
        }

        stage('Package Backend') {
            agent {
                docker {
                    image 'maven:3.9.6-eclipse-temurin-21'
                    args '-v /var/lib/jenkins/.m2:/root/.m2'
                }
            }
            steps {
                checkout scm
                sh './mvnw clean package -DskipTests -Dmaven.repo.local=/var/lib/jenkins/.m2/repository'
            }
        }
    }
}
