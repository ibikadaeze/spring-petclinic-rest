pipeline {
    agent none // Individual stages orchestrate their own isolated tracking containers

    stages {
        stage('Parallel Test & Dependency Audit') {
            parallel {
                stage('Unit Tests') {
                    agent {
                        docker {
                            image 'maven:3.9.6-eclipse-temurin-21'
                            // Enforces root execution privileges to bypass container user permission blocks permanently
                            args '-v /var/lib/jenkins/.m2:/root/.m2 -u root:root'
                        }
                    }
                    steps {
                        checkout scm
                        sh '''
                            export MAVEN_OPTS=""
                            ./mvnw test
                        '''
                    }
                }

                stage('Dependency Audit') {
                    agent {
                        docker {
                            image 'maven:3.9.6-eclipse-temurin-21'
                            args '-v /var/lib/jenkins/.m2:/root/.m2 -u root:root'
                        }
                    }
                    steps {
                        checkout scm
                        sh '''
                            export MAVEN_OPTS=""
                            ./mvnw dependency:analyze
                        '''
                    }
                }
            }
        }

        stage('Package Backend') {
            agent {
                docker {
                    image 'maven:3.9.6-eclipse-temurin-21'
                    args '-v /var/lib/jenkins/.m2:/root/.m2 -u root:root'
                }
            }
            steps {
                checkout scm
                sh '''
                    export MAVEN_OPTS=""
                    ./mvnw clean package -DskipTests
                '''
            }
        }
    }
}
